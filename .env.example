# ======== обязательно ========
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=поменяй_меня
ADMIN_PASSWORD=поменяй_меня

# ======== Supabase ========
# Project Settings → Database → Connection string → "Transaction pooler" (порт 6543)
# Если пусто — локально используется SQLite (gift.db)
DATABASE_URL=

# Project Settings → API: URL проекта и ключи
# Если SUPABASE_URL пусто — файлы хранятся локально в uploads/
SUPABASE_URL=
# Secret key (sb_secret_...) или legacy service_role — ТОЛЬКО на сервере
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_...) или legacy anon — для загрузки файлов из браузера
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BUCKET=gift

# ======== записка дня ========
NOTE_TIME=08:30
TZ_NAME=Asia/Tashkent

# ======== служебное ========
# локально 0, на Vercel включается само
COOKIE_SECURE=0
# 1 — создавать таблицы/бакет при старте (локально по умолчанию да, на Vercel нет:
# там один раз запускаешь `flask --app app init` со своего компьютера)
# AUTO_INIT=1
